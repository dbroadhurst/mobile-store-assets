{
  "name": "mobile-store-assets",
  "version": "1.1.0",
  "description": "Generate every iOS and Android marketing image — App Store + Google Play screenshots, feature graphics, Wear OS, TV banner — from your raw screenshots. Authors ASO copy as a 4-set A/B test matrix.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "David Broadhurst",
    "url": "https://github.com/dbroadhurst"
  },
  "homepage": "https://github.com/dbroadhurst/mobile-store-assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbroadhurst/mobile-store-assets.git"
  },
  "bugs": {
    "url": "https://github.com/dbroadhurst/mobile-store-assets/issues"
  },
  "keywords": [
    "claude-code",
    "claude-plugin",
    "app-store",
    "google-play",
    "ios",
    "android",
    "aso",
    "screenshots",
    "marketing",
    "store-listing",
    "ppo",
    "feature-graphic"
  ],
  "bin": {
    "store-assets-gen": "./bin/store-assets-gen"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "templates",
    ".claude-plugin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:css && tsc --noEmit",
    "build:css": "tailwindcss -i ./templates/tailwind-input.css -o ./templates/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./templates/tailwind-input.css -o ./templates/tailwind.css --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^0.7.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "openai": "^6.37.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
